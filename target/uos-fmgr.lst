=37126					NET_GETIP       = NET_BASE+$06  ; A=1 when an interface has an address (NET_IP/NET_IPSTR)
=37129					NET_OPEN        = NET_BASE+$09  ; A=7 tcp / 8 udp, r0->host, r1=port -> A=socket, C=1 failed
=37132					NET_CLOSE       = NET_BASE+$0c  ; A=socket
=37135					NET_READ        = NET_BASE+$0f  ; A=socket, r1=max -> NET_DATA+2.., NET_LEN; A: 0 ok 1 none 2 closed 3 error
=37138					NET_WRITE       = NET_BASE+$12  ; A=socket, r0->data, X=len (1..200) -> A=status code
=37141					NET_SYNC        = NET_BASE+$15  ; network check + SNTP -> CIA TOD + Ultimate RTC; A=NET_STATE
=37144					NET_APPLYNTP    = NET_BASE+$18  ; NET_DATA+2.. = 48-byte NTP reply -> time/date/TOD; A=0 ok
=37147					NET_RTCTIME     = NET_BASE+$1b  ; Ultimate RTC "YYYY/MM/DD HH:MM:SS" -> NET_DATA; A=status code
=37150					NET_TZSHIFT     = NET_BASE+$1e  ; A=signed quarter-hours -> shift the running TOD
=37153					NET_STATE       = NET_BASE+$21  ; $ff not tried, 0 ntp synced, 1 no reply, 2 no network, 3 no ultimate, 4 open failed
=37154					NET_HOUR        = NET_BASE+$22  ; local time 24 h binary
=37155					NET_MIN         = NET_BASE+$23
=37156					NET_SEC         = NET_BASE+$24
=37157					NET_YEAR        = NET_BASE+$25  ; word
=37159					NET_MON         = NET_BASE+$27
=37160					NET_DAY         = NET_BASE+$28
=37161					NET_WDAY        = NET_BASE+$29  ; 0 = sunday
=37162					NET_TZ          = NET_BASE+$2a  ; quarter-hours applied
=37163					NET_IP          = NET_BASE+$2b  ; 4 bytes
=37167					NET_IPSTR       = NET_BASE+$2f  ; dotted decimal, 0-terminated ("" = none)
=37183					NET_LEN         = NET_BASE+$3f  ; word: payload length of the last reply / read
=37185					NET_SOCK        = NET_BASE+$41
=37186					NET_STAT        = NET_BASE+$42  ; 32 bytes: last status line "NN,TEXT"
=37218					NET_DIRMODE     = NET_BASE+$62  ; 1 = READ_DIR mode (NET_CMD null-separates + counts each block)
=37219					NET_DIRN        = NET_BASE+$63  ; directory entry count after a dir read
=37220					NET_STREAM      = NET_BASE+$64  ; r0=command, r1=len(2..896), r3=callback (0=aggregate)
=37223					NET_TRUNC       = NET_BASE+$67  ; any reply data discarded; reset on each command
=37224					NET_PACKET_TRUNC = NET_BASE+$68 ; current packet clipped; raw stream packets cap at 512
=37225					NET_PACKETS     = NET_BASE+$69  ; word: number of reply packets delivered
