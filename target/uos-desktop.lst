=37155					NET_MIN         = NET_BASE+$23
=37156					NET_SEC         = NET_BASE+$24
=37157					NET_YEAR        = NET_BASE+$25  ; word
=37159					NET_MON         = NET_BASE+$27
=37160					NET_DAY         = NET_BASE+$28
=37161					NET_WDAY        = NET_BASE+$29  ; 0 = sunday
=37162					NET_TZ          = NET_BASE+$2a  ; quarter-hours applied
=37163					NET_IP          = NET_BASE+$2b  ; 4 bytes
=37167					NET_IPSTR       = NET_BASE+$2f  ; dotted decimal, 0-terminated ("" = none)
=37183					NET_LEN         = NET_BASE+$3f  ; word: payload length of the last reply / read
=37185					NET_SOCK        = NET_BASE+$41
