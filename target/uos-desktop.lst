=$4100					UFS_OPEN        = $4100  ; r0 -> NUL name (1..893 bytes), A=1 read / 7 create new read-write
=$4103					UFS_CLOSE       = $4103  ; closes only a service-owned (including uncertain) handle
=$4106					UFS_READ        = $4106  ; r0 -> app buffer, r1=1..512; COUNT actual, EOF at known size
=$4109					UFS_WRITE       = $4109  ; r0 -> app bytes, r1=1..512; read-back verification before success
=$410c					UFS_SEEK        = $410c  ; r0/r1 = 32-bit LE offset, within known file size
=$410f					UFS_TELL        = $410f  ; copy owned handle's tracked SIZE/POS to public result
=$4112					UFS_CLOSEALL    = $4112  ; release owned contexts; first failure returned, failed owner retained
=$4115					UFS_VERSION     = $4115  ; byte = 1
=$4116					UFS_RESULT      = $4116
=$4117					UFS_COUNT       = $4117  ; word; caller must discard buffer/count when C=1
=$4119					UFS_SIZE        = $4119  ; 32-bit LE; size at open or after verified writes
=$411d					UFS_POS         = $411d  ; 32-bit LE; tracked position, valid only after success
=$4121					UFS_EOF         = $4121  ; byte; successful READ reached known end (also set by TELL/SEEK)
=$4122					UFS_MODE        = $4122  ; two bytes: 0=unowned, 1=read, 7=create read-write, $ff=close required
=$4124					UFS_STATUS      = $4124  ; 32-byte NUL-terminated copy of last firmware status for this call
=$8080					UFS_COMMAND     = $8080  ; 896 private bytes, through $83ff; sprites use only $8000..$807f
=$4800					UFS_VIEW        = $4800  ; r0 -> filename, X=context; modal hex/ASCII viewer, Esc returns
=$e0					UFS_BADARG      = $e0
=$e1					UFS_NOTOPEN     = $e1
=$e2					UFS_BUSY        = $e2    ; context owned, foreign file open, or nested call
=$e3					UFS_READONLY    = $e3
=$e4					UFS_PROTOCOL    = $e4
