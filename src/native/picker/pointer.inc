; Generated by native_picker_scene.py from input/pointer.inc.
; Foreground 1351 input for native VIC applications. The C128 ROM restores
; CIA1 PRA=$7f after scanning, selecting port 1. Sample once per jiffy in
; raster lines 80..159. Require another 32 raster lines after noticing the
; jiffy: a delayed ROM/observer IRQ may have scanned well after line 255.
; Shared key ownership uses KEYCHK; IRQ vectors, zero page and CIA DDRs stay.
; The two pointer sprites use the owned surface's unused bitmap/pointer tail.
; Call pgm_close before any display close, replacement or workspace return.
.weak
PM_KEYS_OWNED=0
PM_KEYS_EXTERNAL=0
.endweak
pgm_install:
 .if !PM_KEYS_OWNED
        jsr nk_install
 .endif
        ldx #127
-       lda pgm_shape,x
        sta N_BUFFER,x
        dex
        bpl -
        jsr pgm_select_surface
        lda #$40
        sta N_OFFSET
        lda #$1f
        sta N_OFFSET+1
        lda #128
        sta N_COUNT
        lda #0
        sta N_COUNT+1
        jsr N_WRITE
        bcs pgm_install_return
        lda #$7d
        sta N_BUFFER
        lda #$7e
        sta N_BUFFER+1
        lda #$f8
        sta N_OFFSET
        lda #$23
        sta N_OFFSET+1
        lda #2
        sta N_COUNT
        jsr N_WRITE
        bcs pgm_install_return
        php
        sei
        ldy #11
-       ldx pgm_registers,y
        lda $d000,x
        sta pgm_saved,y
        dey
        bpl -
        lda $0a04
        sta pgm_init_saved
        and #$fe               ; bit 0 enables BASIC's sprite motion IRQ hook
        sta $0a04
        lda #1
        sta pgm_active
        lda #0
        sta pgm_seen
        sta pgm_buttons
        sta pgm_pending
        sta pgm_x+1
        lda #160
        sta pgm_x
        sta pgm_y
        lda #$ff
        sta pgm_tick
        sta pgm_arm
        lda $d017
        and #$fc
        sta $d017
        lda $d01b
        and #$fc
        sta $d01b
        lda $d01c
        and #$fc
        sta $d01c
        lda $d01d
        and #$fc
        sta $d01d
        lda #1
        sta $d027              ; sprite 0: white interior, above black outline
        lda #0
        sta $d028
        jsr pgm_place
        plp
        clc
pgm_install_return:
        rts

pgm_close:
        lda pgm_active
        beq pgm_close_return
        php
        sei
        lda #0
        sta $d015              ; hide before restoring coordinates and format
        sta pgm_active
        sta pgm_seen
        ldy #11
-       ldx pgm_registers,y
        lda pgm_saved,y
        sta $d000,x
        dey
        bpl -
        lda pgm_init_saved
        sta $0a04
        plp
pgm_close_return:
 .if !PM_KEYS_OWNED
        jmp nk_close
 .else
        rts
 .endif

pgm_poll:
        lda #0
        sta pgm_event
        lda pgm_active
        beq pgm_poll_return
        bit $d011
        bmi pgm_poll_return
        lda $d012
        cmp #80
        bcc pgm_poll_return
        cmp #160
        bcs pgm_poll_return
        lda $a2
        cmp pgm_tick
        beq pgm_settling
        sta pgm_tick
        lda $d012
        sta pgm_sample_line
        lda #1
        sta pgm_pending
        rts
pgm_settling:
        lda pgm_pending
        beq pgm_poll_return
        lda $d012
        sec
        sbc pgm_sample_line
        cmp #32                ; >=2 ms; no IRQ masking or busy delay
        bcc pgm_poll_return
        lda #0
        sta pgm_pending
        sta N_READY
        ; Refuse non-ROM CIA configuration rather than changing its ownership.
        lda $dc02
        cmp #$ff
        bne pgm_absent
        lda $dc03
        bne pgm_absent
        lda $dc00
        cmp #$7f
        bne pgm_absent
        lda $d419
        sta pgm_pots
        lda $d41a
        sta pgm_pots+1
        ; A proportional 1351 produces $40..$bf. Open ports read $ff.
        ldx #1
-       lda pgm_pots,x
        cmp #$40
        bcc pgm_absent
        cmp #$c0
        bcs pgm_absent
        dex
        bpl -
        php
        sei
        lda $d02f
        sta pgm_columns
        lda #$ff              ; release both sets of keyboard columns
        sta $dc00
        sta $d02f
        lda $dc01
        and #$10              ; port 1 fire is the left mouse button
        eor #$10
        sta pgm_down
        lda pgm_columns
        sta $d02f
        lda #$7f
        sta $dc00
        plp
        lda pgm_seen
        bne pgm_move
        inc pgm_seen
        lda pgm_pots
        sta pgm_old
        lda pgm_pots+1
        sta pgm_old+1
        lda pgm_down
        sta pgm_buttons        ; held during entry/reconnect cannot launch
        lda #3
        sta $d015
pgm_poll_return:
        rts
pgm_absent:
        lda #0
        sta pgm_seen
        sta pgm_buttons
        sta $d015
        lda #$ff
        sta pgm_arm
        rts
pgm_move:
        lda #0
        sta pgm_moved
        lda pgm_pots
        ldy pgm_old
        jsr pgm_delta
        sty pgm_old
        bcc pgm_vertical
        inc pgm_moved
        clc
        adc pgm_x
        sta pgm_x
        txa
        adc pgm_x+1
        sta pgm_x+1
        bmi pgm_left
        cmp #1
        bcc pgm_vertical
        bne pgm_right
        lda pgm_x
        cmp #64
        bcc pgm_vertical
pgm_right:
        lda #1
        sta pgm_x+1
        lda #63
        bne pgm_set_x
pgm_left:
        lda #0
        sta pgm_x+1
pgm_set_x:
        sta pgm_x
pgm_vertical:
        lda pgm_pots+1
        ldy pgm_old+1
        jsr pgm_delta
        sty pgm_old+1
        bcc pgm_hit_test
        inc pgm_moved
        sta pgm_step
        stx pgm_step+1
        lda pgm_y
        sec
        sbc pgm_step
        tay
        lda #0
        sbc pgm_step+1
        bmi pgm_top
        bne pgm_bottom
        cpy #200
        bcc pgm_set_y
pgm_bottom:
        ldy #199
        bne pgm_set_y
pgm_top:
        ldy #0
pgm_set_y:
        sty pgm_y
pgm_hit_test:
        jsr pgm_place
        jsr pgm_find_hit        ; caller returns X=index or $ff
        stx pgm_hit
        cpx #pgm_control_count
        bcs pgm_button
        lda pgm_moved
        beq pgm_button
        lda #1
        sta pgm_event
pgm_button:
        lda pgm_down
        cmp pgm_buttons
        beq pgm_poll_return
        sta pgm_buttons
        cmp #0
        beq pgm_release
        lda pgm_hit
        sta pgm_arm
        cmp #pgm_control_count
        bcs pgm_poll_return
        lda #1
        sta pgm_event
        rts
pgm_release:
        ldx pgm_arm
        lda #$ff
        sta pgm_arm
        cpx #pgm_control_count
        bcs pgm_poll_return
        cpx pgm_hit
        bne pgm_poll_return
        lda #2
        sta pgm_event
        rts

; Signed 7-bit circular displacement, one pixel per two counter units.
; Ignore +/-1 without advancing the old counter so subpixel motion accumulates.
; A=new, Y=old -> signed X:A, Y=next old, carry=movement.
pgm_delta:
        sty pgm_previous
        sta pgm_sample
        sec
        sbc pgm_previous
        and #$7f
        ldx #0
        cmp #2
        bcc pgm_no_delta
        cmp #127
        beq pgm_no_delta
        cmp #64
        bcc pgm_positive
        ora #$80
        sec
        ror
        dex
        bne pgm_delta_done
pgm_positive:
        lsr
pgm_delta_done:
        ldy pgm_sample
        sec
        rts
pgm_no_delta:
        txa
        clc
        rts

pgm_place:
        lda pgm_x
        clc
        adc #24
        sta $d000
        sta $d002
        lda pgm_x+1
        adc #0
        beq +
        lda #3
+       sta pgm_high
        lda $d010
        and #$fc
        ora pgm_high
        sta $d010
        lda pgm_y
        clc
        adc #50
        sta $d001
        sta $d003
        rts

pgm_active: .byte 0
pgm_seen: .byte 0
pgm_tick: .byte 0
pgm_pending: .byte 0
pgm_sample_line: .byte 0
pgm_x: .word 0
pgm_y: .byte 0
pgm_old: .word 0
pgm_pots: .word 0
pgm_buttons: .byte 0
pgm_down: .byte 0
pgm_arm: .byte $ff
pgm_hit: .byte $ff
pgm_event: .byte 0             ; 0=idle, 1=focus hit, 2=activate hit
pgm_moved: .byte 0
pgm_step: .word 0
pgm_columns: .byte 0
pgm_previous: .byte 0
pgm_sample: .byte 0
pgm_high: .byte 0
pgm_init_saved: .byte 0
pgm_registers: .byte $00,$01,$02,$03,$10,$15,$17,$1b,$1c,$1d,$27,$28
pgm_saved: .fill 12,0
pgm_shape:
.include "../desktop/pointer-shape.inc"
.if !PM_KEYS_EXTERNAL
.include "keys.inc"
.endif
