vd_font_high: .byte 0
vd_count: .byte 0
vd_length: .byte 0
vd_wait_low: .byte 0
vd_wait_high: .byte 0
vd_probe_live: .byte 0
vd_probe_low: .byte 0
vd_probe_high: .byte 0
vd_pointer_visible: .byte 0
vd_pointer_x: .word 0
vd_pointer_y: .byte 0
