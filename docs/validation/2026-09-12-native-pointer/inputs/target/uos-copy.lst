=$4112					UFS_CLOSEALL    = $4112  ; release owned contexts; first failure returned, failed owner retained
=$4115					UFS_VERSION     = $4115  ; byte = 1
=$4116					UFS_RESULT      = $4116
=$4117					UFS_COUNT       = $4117  ; word; caller must discard buffer/count when C=1
