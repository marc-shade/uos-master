=$e4					UFS_PROTOCOL    = $e4
=$e5					UFS_SHORT      = $e5    ; fewer bytes than known size/request says must be available
=$e6					UFS_VERIFY     = $e6    ; write read-back differs
=$e7					UFS_RANGE      = $e7    ; seek past known end / position overflow
